{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/internal/cron/cleanup-notifications",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/internal/cron/auto-status-tick",
            "schedule": "*/5 * * * *"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}